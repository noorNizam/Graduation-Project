# Docker deployment — copy to .env or pass as env vars to docker-compose
# Usage: docker compose --env-file .env.docker up -d

APP_NAME="In Time"
APP_ENV=production
APP_DEBUG=false
# Generate a fixed key: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost

DB_PASSWORD=changeme_db_password_in_production
DB_ROOT_PASSWORD=changeme_root_password_in_production

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=leenocx@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=leenocx@gmail.com
MAIL_FROM_NAME="In Time"

LOG_LEVEL=warning

# Broadcasting / Reverb
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=app-id
REVERB_APP_KEY=app-key
REVERB_APP_SECRET=app-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Identity verification (Didit)
DIDIT_API_KEY=your-api-key
DIDIT_WORKFLOW_ID=your-workflow-uuid
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_API_VERSION=v3
DIDIT_WEBHOOK_SECRET=your-webhook-secret
DIDIT_TIMEOUT=10
DIDIT_DEBUG=false

# Chat message encryption (required in production; base64-encoded 32-byte key)
CHAT_ENCRYPTION_KEY=

