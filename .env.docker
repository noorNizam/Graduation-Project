# Docker deployment — copy to .env or pass as env vars to docker-compose
# Usage: docker compose --env-file .env.docker up -d

APP_NAME="In Time"
APP_ENV=production
APP_DEBUG=false
# Generate a fixed key: docker compose run --rm app php artisan key:generate --show
APP_KEY=base64:wj3Ia1cr9o+sZvOCfqkD/bVYzVKoBvs5OXEI1qU+Muw=
APP_URL=http://localhost

DB_PASSWORD=changeme_db_password_in_production
DB_ROOT_PASSWORD=changeme_root_password_in_production

MAIL_MAILER=smtp
